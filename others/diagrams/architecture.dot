digraph MathAgentArchitecture {
  rankdir=LR;
  fontsize=12;
  fontname="Arial";
  labelloc="t";
  label="MathAgent (minimal) — Layered Architecture + Pipeline Artifacts";

  node [shape=box, style="rounded,filled", fillcolor="white", fontname="Arial"];
  edge [color="#555555", fontname="Arial"];

  // ----- Layers -----
  subgraph cluster_cli {
    label="CLI layer (orchestration)";
    color="#9ecae1";
    style="rounded";
    cli_run [label="src/run_pipeline.py\n(main)"];
  }

  subgraph cluster_core {
    label="Core layer (domain logic)";
    color="#c7e9c0";
    style="rounded";
    core_prompt [label="core/prompt_assemble.py\nassemble_stored_prompt()"];
    core_stages [label="core/stages.py\nnormalize/extract/standardize/boxed"];
    core_vote [label="core/voting.py\nmajority_vote()"];
  }

  subgraph cluster_io {
    label="IO layer (schema + JSONL)";
    color="#fdd0a2";
    style="rounded";
    io_jsonl [label="dataio/jsonl_io.py\niter_jsonl()/write_jsonl_atomic()"];
    io_schema [label="dataio/sample_schema.py\nnormalize_record()/normalize_output_wrapper()"];
  }

  subgraph cluster_infra {
    label="Infra layer (LLM access)";
    color="#dadaeb";
    style="rounded";
    infra_llm [label="infra/llm_client.py\nLLMClient (OpenAI-compatible HTTP)"];
    llm_server [shape=component, fillcolor="#f7f7f7", label="OpenAI-compatible LLM server\n(vLLM / OpenAI / etc.)"];
  }

  // ----- Artifacts (JSONL files) -----
  node [shape=note, style="filled", fillcolor="#fff5f0"];
  in_jsonl [label="Input JSONL\n(datasets/*.jsonl)"];
  out_input_copy [label="example_input.jsonl\n(out/<run>/)"];
  out_stage1_raw [label="stage1_raw_generations.jsonl\n(out/<run>/)"];
  out_stage1 [label="stage1_output.jsonl\n(out/<run>/)"];
  out_stage2 [label="stage2_output.jsonl\n(out/<run>/)"];
  out_stage3 [label="stage3_output.jsonl\n(out/<run>/)"];

  // Restore defaults for non-artifact nodes after artifact section
  node [shape=box, style="rounded,filled", fillcolor="white"];

  // ----- Dependency arrows (code) -----
  cli_run -> io_jsonl;
  cli_run -> io_schema;
  cli_run -> core_prompt;
  cli_run -> core_stages;
  cli_run -> core_vote;
  cli_run -> infra_llm;
  infra_llm -> llm_server;

  // ----- Dataflow arrows (runtime) -----
  in_jsonl -> cli_run [label="--input"];
  cli_run -> out_input_copy [label="copy (best-effort)"];

  // Stage1 solve: 8 samples -> raw archive + prompt assembly
  cli_run -> out_stage1_raw [label="Stage1 solve ×8\nstore raw + extracted"];
  // Stage1 eval: one long-form markdown output
  cli_run -> out_stage1 [label="Stage1 eval ×1\n(sample.jsonl-like content)"];

  // Stage2/3: minimal re-eval when boxed missing
  out_stage1 -> cli_run [label="read for Stage2 routing"];
  cli_run -> out_stage2 [label="Stage2 eval if missing boxed"];
  out_stage2 -> cli_run [label="read for Stage3 routing"];
  cli_run -> out_stage3 [label="Stage3 eval if still missing boxed"];
}


